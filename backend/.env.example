# Defaults work without any configuration; set these only to override them.
PORT=8080
SQLITE_FILE=database/database.sqlite
# IANA time zone used for slot times and the two-hour booking cutoff.
HUT_TIMEZONE=Europe/Rome
# Secret used to sign the session cookie. Required in production.
SESSION_SECRET=replace-with-a-long-random-string
# Mailgun credentials for booking confirmation emails.
# API key provided by Mailgun (or set MAILGUN_API_KEY).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=your-sandbox-domain.mailgun.org
MAILGUN_FROM=Edelweiss Hut <postmaster@your-sandbox-domain.mailgun.org>
# Optional: EU endpoint https://api.eu.mailgun.net
MAILGUN_URL=
MAILGUN_TEMPLATE=booking confirmation