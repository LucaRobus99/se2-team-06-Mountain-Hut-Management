# Defaults work without any configuration; set these only to override them.
PORT=8080
# PostgreSQL server (Docker sets this). Leave empty to use the embedded
# PostgreSQL (PGlite) stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=database/pglite
# Session cookie only over HTTPS (default: true when NODE_ENV=production).
# COOKIE_SECURE=false
# IANA time zone used for slot times and the two-hour booking cutoff.
HUT_TIMEZONE=Europe/Rome
# Secret used to sign the session cookie. Required in production.
SESSION_SECRET=replace-with-a-long-random-string
# Mailgun credentials for booking confirmation and password reset emails.
# Mailgun API key (API_KEY is accepted as an alias).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=your-sandbox-domain.mailgun.org
MAILGUN_FROM=Edelweiss Hut <postmaster@your-sandbox-domain.mailgun.org>
# Optional: EU endpoint https://api.eu.mailgun.net
MAILGUN_URL=
MAILGUN_TEMPLATE=booking-confirmation
# MH-06 booking change email template (email-templates/booking-modification.html).
MAILGUN_UPDATED_TEMPLATE=booking-modification
# MH-08 booking cancellation email template (email-templates/booking-cancelled.html).
MAILGUN_CANCELLED_TEMPLATE=booking-cancelled
# MH-07 password reset email template.
MAILGUN_RESET_TEMPLATE=password-reset
# Public frontend URL used in password reset links (valid 24 hours).
APP_BASE_URL=http://localhost:5173