# Copy this file to .env (same folder as compose.yaml) and fill in the values.

# Release to run, e.g. v1.0.0 (see the GitHub Releases page). Ignored by the
# compose.yaml attached to a release, which already pins its version.
MOUNTAIN_HUT_VERSION=latest

# Database credentials (used only inside Docker; choose any values).
# Use letters, digits, - and _ only: they are embedded in a connection URL.
POSTGRES_USER=mountain_hut
POSTGRES_PASSWORD=change-me

# Long random string used to sign the login cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Port on this machine where the app is served, and its public URL
# (used in password reset emails).
APP_PORT=8081
APP_BASE_URL=http://localhost:8081

HUT_TIMEZONE=Europe/Rome

# Optional: Mailgun credentials. Without them emails are skipped and the app still works.
MAILGUN_API_KEY=
# API_KEY is accepted as an alias of MAILGUN_API_KEY.
API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
# EU accounts: https://api.eu.mailgun.net
MAILGUN_URL=
# Template names must match the templates uploaded to the Mailgun domain.
# The Mailgun templates API rejects names containing spaces.
MAILGUN_TEMPLATE=booking-confirmation
MAILGUN_UPDATED_TEMPLATE=booking-modification
MAILGUN_CANCELLED_TEMPLATE=booking-cancelled
MAILGUN_RESET_TEMPLATE=password-reset
